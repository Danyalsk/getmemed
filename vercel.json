{
  "services": {
    "memed-api": {
      "root": "backend",
      "entrypoint": "src/app.ts",
      "buildCommand": "npm ci --include=dev && npm run build && npm prune --omit=dev"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "memed-api"
      }
    }
  ]
}
