NODE_ENV=development
PORT=4000
# Must be a replica set (Atlas clusters are) — payouts run inside transactions
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/memed
JWT_SECRET=replace-with-a-random-string-of-at-least-32-chars
JWT_TTL_SECONDS=604800
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000
# Optional — live campaign list is cached when set
REDIS_URL=redis://localhost:6379
SPIKE_MIN_DELTA=5000
SPIKE_VIEWS_PER_HOUR=20000
